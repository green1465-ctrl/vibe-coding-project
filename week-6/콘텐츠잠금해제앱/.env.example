# Supabase Postgres (사용자 본인이 채우기)
# Supabase 대시보드 > Project Settings > Database > Connection string > URI (Pooler / 6543 포트)
DATABASE_URL=postgresql://...

# JWT (아무 문자열, 32자 이상 권장)
# 예: openssl rand -hex 32
JWT_SECRET=

# TossPayments 테스트 키 (https://developers.tosspayments.com)
TOSS_SECRET_KEY=test_sk_...
TOSS_CLIENT_KEY=test_ck_...

# 서버 포트
PORT=3000
