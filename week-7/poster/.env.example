# week-7/poster — API 키 양식
# 실제 키는 이 파일을 .env로 복사한 뒤 본인 키로 채워 넣으세요.
# .env 는 .gitignore 에 의해 git에 올라가지 않습니다.

# OpenAI Images API (gpt-image-1) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-여기에_새로_발급받은_키

# fal.ai (Z-Image Turbo, 기존 generate.ps1 사용) — https://fal.ai/dashboard/keys
FAL_KEY=여기에_새로_발급받은_fal_키
